#!/bin/sh
# Minimal configure script for detecting SuiteSparse (UMFPACK) and writing src/Makevars
# Place this file in the package root and make it executable (chmod +x configure).

set -e

PKGNAME="yourPackageName"  # optional, for messages

# Allow overrides via environment
: "${SUITESPARSE_PREFIX:=}"
: "${SUITESPARSE_INCLUDE:=}"
: "${SUITESPARSE_LIB:=}"

echo "Running configure for ${PKGNAME}..."

# Candidate prefixes to try (macOS / Linux)
CANDIDATES="/opt/homebrew /usr/local /usr"

# helper to test header presence
check_header() {
  dir="$1"
  [ -d "$dir/include/suitesparse" ] || [ -d "$dir/include" -a -f "$dir/include/suitesparse/UMFPACK.h" ]
}

# If user gave include or prefix, prefer those
if [ -n "$SUITESPARSE_INCLUDE" ]; then
  INCLUDE_DIR="$SUITESPARSE_INCLUDE"
elif [ -n "$SUITESPARSE_PREFIX" ]; then
  INCLUDE_DIR="$SUITESPARSE_PREFIX/include/suitesparse"
fi

if [ -n "$SUITESPARSE_LIB" ]; then
  LIB_DIR="$SUITESPARSE_LIB"
elif [ -n "$SUITESPARSE_PREFIX" ]; then
  LIB_DIR="$SUITESPARSE_PREFIX/lib"
fi

# Try to autodetect if not provided
if [ -z "$INCLUDE_DIR" ]; then
  for p in $CANDIDATES; do
    if [ -d "$p/include/suitesparse" ] || [ -f "$p/include/suitesparse/UMFPACK.h" ]; then
      INCLUDE_DIR="$p/include/suitesparse"
      LIB_DIR="$p/lib"
      break
    fi
  done
fi

# Final checks
if [ -n "$INCLUDE_DIR" ]; then
  echo "Found SuiteSparse headers in: $INCLUDE_DIR"
else
  echo "Warning: SuiteSparse headers not found by configure. You may need to set SUITESPARSE_INCLUDE or SUITESPARSE_PREFIX."
fi

if [ -n "$LIB_DIR" ]; then
  echo "Assuming libs in: $LIB_DIR"
else
  echo "Warning: SuiteSparse libs not found by configure. You may need to set SUITESPARSE_LIB or SUITESPARSE_PREFIX."
fi

# Write src/Makevars (overwrite). You can adapt template lines as needed.
mkdir -p src

cat > src/Makevars <<EOF
# Generated by configure
PKG_CPPFLAGS = -DNTIMER
PKG_LIBS = \$(BLAS_LIBS)
EOF

if [ -n "$INCLUDE_DIR" ]; then
  echo "PKG_CPPFLAGS += -I${INCLUDE_DIR}" >> src/Makevars
fi

if [ -n "$LIB_DIR" ]; then
  echo "PKG_LIBS += -L${LIB_DIR} -lumfpack" >> src/Makevars
else
  # If no lib dir found, still try linking by name only (may work on some systems)
  echo "PKG_LIBS += -lumfpack" >> src/Makevars
fi

echo "Wrote src/Makevars:"
sed -n '1,200p' src/Makevars

exit 0
